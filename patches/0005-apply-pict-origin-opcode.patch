+#[test]
+fn pict_origin_opcode_moves_later_coordinates() {
+    // A recorded SetOrigin(dh, dv) makes later points draw at p - (dh, dv).
+    // Imaging With QuickDraw 1994, pp. 2-37 and A-6.
+    let frame = (0, 0, 64, 96);
+    let mut moved = Vec::new();
+    super::recording_push_word(&mut moved, 0x000C);
+    moved.extend_from_slice(&5i16.to_be_bytes());
+    moved.extend_from_slice(&(-30i16).to_be_bytes());
+    super::recording_push_long_text(&mut moved, 10, 20, b"X");
+    let moved = super::finish_recording(frame, moved);
+
+    let mut absolute = Vec::new();
+    super::recording_push_long_text(&mut absolute, 40, 15, b"X");
+    let absolute = super::finish_recording(frame, absolute);
+
+    let actual = render_text_picture(&moved, 96, 64);
+    let expected = render_text_picture(&absolute, 96, 64);
+    assert_eq!(actual, expected);
+    assert!(expected
+        .chunks_exact(96)
+        .skip(30)
+        .any(|row| row[10..30].contains(&255)));
+}
