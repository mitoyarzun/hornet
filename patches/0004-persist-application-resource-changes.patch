+    /// Return the VFS key of the launched application's resource fork.
+    pub(crate) fn application_resource_fork_key(&self) -> Option<String> {
+        let path = self.launched_app_path()?.to_owned();
+        self.find_vfs_rsrc_file(&path)
+    }
+
+    /// Take the application's resource data from its VFS resource fork.
+    ///
+    /// A frontend restores saved files after the application's resource map
+    /// is loaded. If a saved copy of the application file replaces its
+    /// resource fork, use that data for the resources in the map, so changes
+    /// that the application wrote with WriteResource survive a restart.
+    /// Return the number of resources that changed.
+    pub(crate) fn refresh_application_resources_from_vfs(&mut self, bus: &mut MacMemoryBus) -> usize {
+        let Some(key) = self.application_resource_fork_key() else {
+            return 0;
+        };
+        let Some(fork) = self.vfs_rsrc.get(&key).and_then(|bytes| ResourceFork::parse(bytes)) else {
+            return 0;
+        };
+        let mut changed = 0;
+        for (&(res_type, res_id), resource) in fork.resources() {
+            let Some(loaded_ptr) = self.resources.as_ref().and_then(|resources| {
+                let file = resources.files.get(&0)?;
+                file.attrs.get(&(res_type, res_id))?;
+                Some(file.loaded.get(&(res_type, res_id)).copied())
+            }) else {
+                continue;
+            };
+            if self.resource_backing_data.get(&(0, res_type, res_id)) == Some(&resource.data) {
+                continue;
+            }
+            if let Some(ptr) = loaded_ptr.filter(|&ptr| ptr != 0) {
+                // A resource that is already in memory keeps its block. Only
+                // replace the bytes when the size is the same.
+                if bus.get_alloc_size(ptr) != Some(resource.data.len() as u32) {
+                    continue;
+                }
+                bus.write_bytes(ptr, &resource.data);
+            }
+            self.remember_resource_backing_data(0, res_type, res_id, resource.data.clone());
+            changed += 1;
+        }
+        changed
+    }
