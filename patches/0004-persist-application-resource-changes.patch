+fn application_fork_for_test(data: &[u8], code: &[u8]) -> Vec<u8> {
+    use crate::managers::resource::{serialize_resource_fork, ResourceForkEntry};
+    serialize_resource_fork(&[
+        ResourceForkEntry {
+            res_type: *b"DATA",
+            id: 128,
+            name: Vec::new(),
+            data: data.to_vec(),
+            attrs: 0,
+        },
+        ResourceForkEntry {
+            res_type: *b"CODE",
+            id: 1,
+            name: Vec::new(),
+            data: code.to_vec(),
+            attrs: 0,
+        },
+    ])
+    .unwrap()
+}
