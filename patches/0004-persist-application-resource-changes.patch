+/// Load an application map (refnum 0) with DATA 128 and a CODE 1 resource
+/// whose bytes in memory differ from the file, as after relocation.
+fn setup_application_resources_for_writeback(
+    disp: &mut super::super::TrapDispatcher,
+    bus: &mut crate::memory::MacMemoryBus,
+) -> (u32, u32) {
+    let data_ptr = bus.alloc(4);
+    bus.write_bytes(data_ptr, b"OLD!");
+    let code_ptr = bus.alloc(4);
+    bus.write_bytes(code_ptr, b"RELO");
+    let file = ResourceFileMap {
+        loaded: HashMap::from([((*b"DATA", 128), data_ptr), ((*b"CODE", 1), code_ptr)]),
+        named: HashMap::new(),
+        names_by_id: HashMap::new(),
+        attrs: HashMap::from([((*b"DATA", 128), 0), ((*b"CODE", 1), 0)]),
+        map_attrs: 0,
+    };
+    disp.set_loaded_resources_for_test(LoadedResources {
+        files: HashMap::from([(0, file)]),
+        names: HashMap::from([(0, "Application".to_string())]),
+        search_order: vec![0],
+        current_file: 0,
+    });
+    disp.remember_resource_backing_data(0, *b"DATA", 128, b"OLD!".to_vec());
+    disp.remember_resource_backing_data(0, *b"CODE", 1, b"FILE".to_vec());
+    disp.vfs_rsrc.insert(
+        "Apps/Game".to_string(),
+        application_fork_for_test(b"OLD!", b"FILE"),
+    );
+    disp.set_launched_app_path("Apps/Game");
+    (data_ptr, code_ptr)
+}
+
+// Inside Macintosh: More Macintosh Toolbox (1993), pp. 1-109 to 1-111:
+// WriteResource writes a changed resource to its resource file. The
+// application's own resources live in refnum 0, whose file is the launched
+// application.
+#[test]
+fn writeresource_on_application_resource_updates_launched_application_fork() {
+    let (mut disp, mut cpu, mut bus) = setup();
+    let (data_ptr, _) = setup_application_resources_for_writeback(&mut disp, &mut bus);
+    let handle = disp.get_or_create_resource_handle(&mut bus, *b"DATA", 128, data_ptr);
+    bus.write_bytes(data_ptr, b"NEW!");
+
+    bus.write_long(TEST_SP, handle);
+    call(&mut disp, true, 0x1AA, &mut cpu, &mut bus).unwrap(); // ChangedResource
+    cpu.write_reg(Register::A7, TEST_SP);
+    bus.write_long(TEST_SP, handle);
+    call(&mut disp, true, 0x1B0, &mut cpu, &mut bus).unwrap(); // WriteResource
+
+    let fork =
+        crate::managers::resource::ResourceFork::parse(disp.vfs_rsrc.get("Apps/Game").unwrap())
+            .unwrap();
+    assert_eq!(fork.get(*b"DATA", 128).unwrap().data, b"NEW!");
+    // Unchanged resources keep their file bytes, not the relocated memory.
+    assert_eq!(fork.get(*b"CODE", 1).unwrap().data, b"FILE");
+}
+
+#[test]
+fn restored_application_fork_replaces_application_resource_data() {
+    let (mut disp, _cpu, mut bus) = setup();
+    let (data_ptr, code_ptr) = setup_application_resources_for_writeback(&mut disp, &mut bus);
+    disp.vfs_rsrc.insert(
+        "Apps/Game".to_string(),
+        application_fork_for_test(b"NEW!", b"FILE"),
+    );
+
+    assert_eq!(disp.refresh_application_resources_from_vfs(&mut bus), 1);
+    assert_eq!(bus.read_bytes(data_ptr, 4), b"NEW!");
+    assert_eq!(bus.read_bytes(code_ptr, 4), b"RELO");
+}
