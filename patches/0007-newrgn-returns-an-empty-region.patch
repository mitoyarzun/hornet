+    #[test]
+    fn new_rgn_is_empty_after_an_old_region_is_disposed() {
+        // NewRgn returns the empty region (0,0,0,0) even when the allocator
+        // gives back the block of a disposed region.
+        // Imaging With QuickDraw (1994), p. 3-91.
+        let (mut d, mut cpu, mut bus) = setup();
+        d.dispatch_quickdraw(true, 0x0D8, &mut cpu, &mut bus)
+            .unwrap()
+            .unwrap();
+        let old_handle = bus.read_long(TEST_SP);
+        let old_ptr = bus.read_long(old_handle);
+        bus.write_bytes(old_ptr + 2, &[0, 0, 0, 0, 1, 0x24, 1, 0xF0]);
+        bus.write_long(TEST_SP, old_handle);
+        d.dispatch_quickdraw(true, 0x0D9, &mut cpu, &mut bus)
+            .unwrap()
+            .unwrap();
+
+        cpu.write_reg(Register::A7, TEST_SP);
+        d.dispatch_quickdraw(true, 0x0D8, &mut cpu, &mut bus)
+            .unwrap()
+            .unwrap();
+        let ptr = bus.read_long(bus.read_long(TEST_SP));
+        assert_eq!(bus.read_word(ptr), 10);
+        assert_eq!(bus.read_bytes(ptr + 2, 8), vec![0; 8]);
+    }
