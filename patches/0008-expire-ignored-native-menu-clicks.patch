+#[test]
+fn ignored_native_menu_mouse_down_expires_and_releases_key_events() {
+    // A flight simulator in flight reads one event per frame and never
+    // calls MenuSelect. The latched click must not hold back its keys for
+    // longer than the click lifetime, and the stale command must go away.
+    let (mut disp, _cpu, mut bus) = setup();
+    disp.set_tick_count_for_test(&mut bus, 100);
+    assert!(disp.pending_native_menu_selection.stage((4, 8)));
+    disp.pending_native_menu_event = Some(QueuedEvent {
+        what: 1,
+        message: 0,
+        when: 0,
+        where_v: 10,
+        where_h: 42,
+        modifiers: 0,
+    });
+    assert_eq!(disp.dequeue_event(&bus, u16::MAX).0, 1);
+    disp.event_queue.push_back(QueuedEvent {
+        what: 3,
+        message: 0x0161,
+        when: 0,
+        where_v: 0,
+        where_h: 0,
+        modifiers: 0,
+    });
+
+    let lifetime = TrapDispatcher::NATIVE_MENU_CLICK_LIFETIME_TICKS;
+    for tick in 101..100 + lifetime {
+        disp.set_tick_count_for_test(&mut bus, tick);
+        assert_eq!(disp.dequeue_event(&bus, u16::MAX).0, 1, "tick {tick}");
+    }
+
+    disp.set_tick_count_for_test(&mut bus, 100 + lifetime);
+    let event = disp.dequeue_event(&bus, u16::MAX);
+    assert_eq!((event.0, event.1), (3, 0x0161));
+    assert!(disp.pending_native_menu_event.is_none());
+    assert!(!disp.has_pending_native_menu_event());
+    assert!(disp.pending_native_menu_selection.take().is_none());
+}
