+    #[test]
+    fn te_text_box_draws_a_line_taller_than_the_box() {
+        // Courier 12 is 13 pixels from ascent to descent. TETextBox still
+        // draws a line whose top is inside a 12-pixel box.
+        let (mut disp, mut cpu, mut bus) = setup_with_port();
+        let port_ptr = 0x181000u32;
+        disp
+            .current_port
+            .with_mut(|current_port| *current_port = port_ptr);
+        disp.tx_font = 22;
+        disp.tx_size = 12;
+        bus.write_word(port_ptr + 68, 22);
+        bus.write_word(port_ptr + 74, 12);
+        disp.pn_loc = (0, 0);
+
+        let text = b"Name";
+        let text_ptr = 0x200280u32;
+        bus.write_bytes(text_ptr, text);
+        let box_ptr = 0x2002C0u32;
+        for (offset, value) in [36i16, 144, 48, 188].into_iter().enumerate() {
+            bus.write_word(box_ptr + offset as u32 * 2, value as u16);
+        }
+
+        let sp = TEST_SP - 14;
+        cpu.write_reg(Register::A7, sp);
+        bus.write_word(sp, 0);
+        bus.write_long(sp + 2, box_ptr);
+        bus.write_long(sp + 6, text.len() as u32);
+        bus.write_long(sp + 10, text_ptr);
+        let result = disp.dispatch_dialog(true, 0x1CE, &mut cpu, &mut bus);
+        assert!(result.unwrap().is_ok());
+
+        let metrics = crate::quickdraw::text::get_font_metrics(22, 12);
+        assert!(metrics.ascent + metrics.descent > 12);
+        assert_eq!(disp.pn_loc.0, 36 + metrics.ascent);
+        assert!(disp.pn_loc.1 > 144);
+    }
+
