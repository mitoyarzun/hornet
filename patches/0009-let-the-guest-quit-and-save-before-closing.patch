+    /// Macintosh Toolbox Essentials (1992), pp. 2-30 to 2-32.
+    pub(crate) fn queue_quit_application_event(&mut self) -> bool {
+        const K_AE_QUIT_APPLICATION: u32 = 0x7175_6974; // 'quit'
+        if self
+            .apple_event_handler_for(Self::K_CORE_EVENT_CLASS, K_AE_QUIT_APPLICATION)
+            .is_none()
+        {
+            return false;
+        }
+        let tick = self.current_tick();
+        self.event_queue.push_back(super::dispatch::QueuedEvent {
+            what: Self::K_HIGH_LEVEL_EVENT,
+            message: Self::K_CORE_EVENT_CLASS,
+            when: tick,
+            where_v: (K_AE_QUIT_APPLICATION >> 16) as i16,
+            where_h: (K_AE_QUIT_APPLICATION & 0xFFFF) as i16,
+            modifiers: 0,
+        });
+        true
+    }
