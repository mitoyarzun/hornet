+#[test]
+fn find_vfs_file_matches_hfs_basename_containing_slash() {
+    let disp = super::super::TrapDispatcher::new();
+    let key = "F\u{F02F}A-18 2.0 Demo/F\u{F02F}A-18 Data 2.0 (demo)";
+    disp.vfs.insert(key.to_string(), vec![1]);
+
+    assert_eq!(
+        disp.find_vfs_file("F/A-18 Data 2.0 (demo)"),
+        Some(key.to_string())
+    );
+    assert_eq!(disp.find_vfs_file("F/A-18 Data"), None);
+}
