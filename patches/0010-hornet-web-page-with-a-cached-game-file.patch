diff --git a/www/src/hornet.css b/www/src/hornet.css
new file mode 100644
index 00000000..0c8c5298
--- /dev/null
+++ b/www/src/hornet.css
@@ -0,0 +1,118 @@
+/* Single-game page for F/A-18 Hornet 2.0. */
+.hornet .app__main {
+  padding-top: calc(var(--safe-area-top) + 24px);
+}
+
+.hornet .game-download {
+  display: none;
+}
+
+.hornet-status,
+.hornet-file {
+  max-width: var(--game-width);
+  margin: 16px auto;
+  color: var(--muted);
+}
+
+.hornet-pick {
+  max-width: var(--content-width);
+  margin: 32px auto;
+  padding: 24px;
+  border: 1px solid var(--rule);
+  background: var(--surface);
+  color: var(--body);
+}
+
+.hornet-pick h2 {
+  margin-top: 0;
+  color: var(--ink);
+}
+
+.hornet-pick__button {
+  display: inline-block;
+  margin-top: 8px;
+  padding: 10px 18px;
+  background: var(--accent);
+  color: var(--on-accent);
+  cursor: pointer;
+}
+
+.hornet-pick__button:focus-within {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.hornet-pick__input {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  opacity: 0;
+}
+
+.hornet-pick__error {
+  color: var(--accent);
+}
+
+.hornet-pick__error.hidden {
+  display: none;
+}
+
+.hornet-file__forget {
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--accent);
+  font: inherit;
+  text-decoration: underline;
+  cursor: pointer;
+}
+
+.hornet-controls {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px 14px;
+  max-width: var(--game-width);
+  margin: 12px auto 0;
+  color: var(--muted);
+}
+
+.hornet-controls__fullscreen {
+  padding: 8px 16px;
+  border: 0;
+  background: var(--accent);
+  color: var(--on-accent);
+  font: inherit;
+  cursor: pointer;
+}
+
+.hornet-controls__note {
+  max-width: var(--game-width);
+  margin: 8px auto 0;
+  color: var(--accent);
+}
+
+.hornet-controls__note.hidden {
+  display: none;
+}
+
+/* The game screen in full screen: fill the display, keep the 4:3 shape and
+   center it on black. */
+.game-canvas-wrap:fullscreen {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 100vw;
+  height: 100vh;
+  max-width: none;
+  border: 0;
+  border-radius: 0;
+  aspect-ratio: auto;
+  background: #000;
+}
+
+.game-canvas-wrap:fullscreen .game-canvas {
+  flex: 0 0 auto;
+  width: min(100vw, 100vh * var(--game-aspect-width) / var(--game-aspect-height));
+  height: min(100vh, 100vw * var(--game-aspect-height) / var(--game-aspect-width));
+}
