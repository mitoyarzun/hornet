+//! Single-game page for F/A-18 Hornet 2.0 with a game file that the player
+//! supplies. The page keeps the file in IndexedDB, so later visits boot from
+//! that copy and do not ask for the file again.
+
+use leptos::prelude::*;
+use leptos::task::spawn_local;
+use wasm_bindgen::{prelude::wasm_bindgen, JsCast, JsValue};
+use wasm_bindgen_futures::JsFuture;
+use web_sys::{Event, HtmlInputElement};
+
+use crate::catalogue::{games, Game, GameAssets, GameSettings};
+use crate::components::game_screen::GameScreen;
+
+const HORNET_GAME_ID: &str = "fa-18-hornet-20";
+const SCREEN_SIZE_KEY: &str = "hornet.screen-size";
+/// Mac screen sizes that the game supports, as in the desktop launcher. Its
+/// largest view is 1152 pixels wide.
+const SCREEN_SIZES: [(u16, u16); 3] = [(800, 600), (1024, 768), (1152, 870)];
+const HORNET_ABOUT_HTML: &str = r#"
+<h2>Flying</h2>
+<p>The pointer position is the control stick. Put the mouse in the center of
+the screen before you increase thrust. Open the <strong>Mission</strong> menu
+and select <strong>Training…</strong> for the training missions, or
+<strong>Fly</strong> for the current Tour of Duty mission.</p>
+<p>Delete sets thrust to 100%, and each next press adds one afterburner stage.
+<code>G</code> moves the landing gear, the Space bar is the brake, and
+<code>1</code> <code>2</code> <code>3</code> select the cockpit, look-down
+and external views. Esc stops the flight.</p>
+<p>Read the <a href="https://github.com/mitoyarzun/hornet#flying" target="_blank"
+rel="noopener noreferrer">full flying guide</a> in the project README.</p>
+<h2>Your game file</h2>
+<p>This browser keeps the game file and the saved files, such as the pilot
+dossier. The next visits start the game directly. Click <strong>Use a different
+game file</strong> below the game to remove the copy.</p>
+"#;
+
+#[wasm_bindgen(inline_js = r#"
+const DB_NAME = "hornet-game-file";
+const STORE = "files";
+const KEY = "game";
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DB_NAME, 1);
+    request.onupgradeneeded = () => request.result.createObjectStore(STORE);
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+async function run(mode, action) {
+  const db = await openDb();
+  try {
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction(STORE, mode);
+      const request = action(tx.objectStore(STORE));
+      tx.oncomplete = () => resolve(request.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error || new Error("IndexedDB transaction aborted"));
+    });
+  } finally {
+    db.close();
+  }
+}
+
+// The archive fetch rejects text/html, and a File can have any type. Keep the
+// bytes as an octet stream.
+export async function hornetStoreGameFile(file) {
+  const blob = new Blob([file], { type: "application/octet-stream" });
+  if (navigator.storage && navigator.storage.persist) {
+    try { await navigator.storage.persist(); } catch (_) {}
+  }
+  await run("readwrite", (store) => store.put({ name: file.name, blob }, KEY));
+  return URL.createObjectURL(blob);
+}
+
+export async function hornetLoadGameFile() {
+  const entry = await run("readonly", (store) => store.get(KEY));
+  if (!entry || !entry.blob) return null;
+  return [entry.name, URL.createObjectURL(entry.blob)];
+}
+
+export async function hornetClearGameFile() {
+  await run("readwrite", (store) => store.delete(KEY));
+}
+
+// Put the game screen in fullscreen. Then lock the keyboard, so that the
+// browser sends its own shortcuts, such as Command-W, to the game. Only
+// Chromium browsers have the Keyboard Lock API. Returns true for a lock.
+export async function hornetEnterFullscreen() {
+  const wrap = document.querySelector(".game-canvas-wrap");
+  if (!wrap) throw new Error("The game is not running");
+  if (document.fullscreenElement !== wrap) {
+    await wrap.requestFullscreen({ navigationUI: "hide" });
+  }
+  wrap.querySelector("canvas")?.focus();
+  if (!navigator.keyboard || !navigator.keyboard.lock) return false;
+  try {
+    await navigator.keyboard.lock();
+    return true;
+  } catch (_) {
+    return false;
+  }
+}
+
+document.addEventListener("fullscreenchange", () => {
+  if (!document.fullscreenElement && navigator.keyboard && navigator.keyboard.unlock) {
+    navigator.keyboard.unlock();
+  }
+});
+"#)]
+extern "C" {
+    #[wasm_bindgen(js_name = hornetStoreGameFile)]
+    fn store_game_file(file: &web_sys::File) -> js_sys::Promise;
+    #[wasm_bindgen(js_name = hornetLoadGameFile)]
+    fn load_game_file() -> js_sys::Promise;
+    #[wasm_bindgen(js_name = hornetClearGameFile)]
+    fn clear_game_file() -> js_sys::Promise;
+    #[wasm_bindgen(js_name = hornetEnterFullscreen)]
+    fn enter_fullscreen() -> js_sys::Promise;
+}
+
+#[derive(Clone, Debug, PartialEq)]
+enum PageState {
+    Checking,
+    NeedFile(String),
+    Ready { name: String, game: &'static Game },
+}
+
+/// Make the catalogue entry for Hornet use the player's file. The demo entry
+/// hides the menu bar, but the retail game needs its Mission menu.
+fn hornet_game(archive_url: String) -> &'static Game {
+    let base = games()
+        .iter()
+        .find(|game| game.id == HORNET_GAME_ID)
+        .expect("the catalogue contains F/A-18 Hornet 2.0");
+    let archive_url: &'static str = Box::leak(archive_url.into_boxed_str());
+    Box::leak(Box::new(Game {
+        approved: true,
+        assets: GameAssets {
+            archive_path: archive_url,
+            archive_download_name: "",
+            web_pack_path: None,
+            architecture_archives: &[],
+            ..base.assets
+        },
+        description: "Your own copy of the game, kept in this browser.",
+        content_html: HORNET_ABOUT_HTML,
+        settings: GameSettings {
+            show_menu_bar: true,
+            plugins: &[],
+            ..base.settings
+        },
+        ..*base
+    }))
+}
+
+fn js_error(value: JsValue) -> String {
+    value
+        .dyn_ref::<js_sys::Error>()
+        .map(|error| String::from(error.message()))
+        .or_else(|| value.as_string())
+        .unwrap_or_else(|| format!("{value:?}"))
+}
+
+fn local_storage() -> Option<web_sys::Storage> {
+    web_sys::window()?.local_storage().ok().flatten()
+}
+
+fn saved_screen_size() -> (u16, u16) {
+    local_storage()
+        .and_then(|storage| storage.get_item(SCREEN_SIZE_KEY).ok().flatten())
+        .and_then(|value| {
+            let (width, height) = value.split_once('x')?;
+            Some((width.parse().ok()?, height.parse().ok()?))
+        })
+        .filter(|size| SCREEN_SIZES.contains(size))
+        .unwrap_or(SCREEN_SIZES[0])
+}
+
+#[component]
+pub fn HornetApp() -> impl IntoView {
+    let state = RwSignal::new(PageState::Checking);
+
+    // The runtime reads the screen size one time, so set it before the game
+    // starts. A change of size reloads the page.
+    let screen_size = saved_screen_size();
+    systemless::systems::macintosh::machine_profile::set_reference_screen_size(
+        screen_size.0,
+        screen_size.1,
+    );
+    let on_screen_size = move |event: Event| {
+        let Some(select) = event
+            .target()
+            .and_then(|target| target.dyn_into::<web_sys::HtmlSelectElement>().ok())
+        else {
+            return;
+        };
+        if let Some(storage) = local_storage() {
+            let _ = storage.set_item(SCREEN_SIZE_KEY, &select.value());
+        }
+        if let Some(window) = web_sys::window() {
+            let _ = window.location().reload();
+        }
+    };
+
+    spawn_local(async move {
+        let next = match JsFuture::from(load_game_file()).await {
+            Ok(value) if value.is_null() => PageState::NeedFile(String::new()),
+            Ok(value) => {
+                let entry: js_sys::Array = value.unchecked_into();
+                PageState::Ready {
+                    name: entry.get(0).as_string().unwrap_or_default(),
+                    game: hornet_game(entry.get(1).as_string().unwrap_or_default()),
+                }
+            }
+            Err(error) => PageState::NeedFile(format!(
+                "Could not read the saved game file: {}",
+                js_error(error)
+            )),
+        };
+        state.set(next);
+    });
+
+    let on_pick = move |event: Event| {
+        let Some(input) = event
+            .target()
+            .and_then(|target| target.dyn_into::<HtmlInputElement>().ok())
+        else {
+            return;
+        };
+        let Some(file) = input.files().and_then(|files| files.item(0)) else {
+            return;
+        };
+        crate::emulator::begin_audio_from_user_gesture();
+        state.set(PageState::Checking);
+        spawn_local(async move {
+            let name = file.name();
+            state.set(match JsFuture::from(store_game_file(&file)).await {
+                Ok(url) => PageState::Ready {
+                    name,
+                    game: hornet_game(url.as_string().unwrap_or_default()),
+                },
+                Err(error) => {
+                    PageState::NeedFile(format!("Could not keep the game file: {}", js_error(error)))
+                }
+            });
+        });
+    };
+
+    let fullscreen_note = RwSignal::new(String::new());
+    let on_fullscreen = move |_| {
+        // Call requestFullscreen in the click handler: the browser permits it
+        // only during a user gesture.
+        let promise = enter_fullscreen();
+        spawn_local(async move {
+            fullscreen_note.set(match JsFuture::from(promise).await {
+                Ok(locked) if locked.as_bool() == Some(true) => String::new(),
+                Ok(_) => "This browser keeps some \u{2318} shortcuts, such as \u{2318}W and \u{2318}Q. \
+                          Use Chrome or Edge to send all of them to the game."
+                    .into(),
+                Err(error) => format!("Could not start full screen: {}", js_error(error)),
+            });
+        });
+    };
+
+    let on_forget = move |_| {
+        spawn_local(async move {
+            let message = match JsFuture::from(clear_game_file()).await {
+                Ok(_) => String::new(),
+                Err(error) => format!("Could not remove the saved game file: {}", js_error(error)),
+            };
+            // Reload so that the running game stops and frees its memory.
+            if message.is_empty() {
+                if let Some(window) = web_sys::window() {
+                    let _ = window.location().reload();
+                    return;
+                }
+            }
+            state.set(PageState::NeedFile(message));
+        });
+    };
+
+    view! {
+        // Show the game screen at its own size when the window is wide enough.
+        <div class="app hornet" data-view="playing" style=format!("--game-width: {}px", screen_size.0)>
+            <main class="app__main">
+                <div class="game-page game-page--focused">
+                    <header class="game-heading">
+                        <h1 class="game-title">"F/A-18 Hornet 2.0"</h1>
+                        <div class="game-heading__meta">
+                            <p class="game-byline">
+                                "Graphic Simulations Corporation \u{b7} 1995 \u{b7} runs on "
+                                <a href="https://github.com/benletchford/systemless" target="_blank" rel="noopener noreferrer">"Systemless"</a>
+                            </p>
+                        </div>
+                    </header>
+                    {move || match state.get() {
+                        PageState::Checking => view! {
+                            <p class="hornet-status">"Loading\u{2026}"</p>
+                        }.into_any(),
+                        PageState::NeedFile(error) => {
+                            let no_error = error.is_empty();
+                            view! {
+                            <section class="hornet-pick">
+                                <h2>"Choose your copy of the game"</h2>
+                                <p>
+                                    "Select a StuffIt archive (.sit), a MacBinary file (.bin) or an HFS disk image, "
+                                    "such as a Toast image of the retail disc or the free 2.0 demo. "
+                                    "The file stays in this browser. The page sends it to no server."
+                                </p>
+                                <label class="hornet-pick__button">
+                                    "Choose game file\u{2026}"
+                                    <input
+                                        class="hornet-pick__input"
+                                        type="file"
+                                        accept=".sit,.bin,.macbin,.img,.image,.dsk,.iso,.toast,.dmg,.cdr,application/octet-stream"
+                                        on:change=on_pick
+                                    />
+                                </label>
+                                <p class="hornet-pick__error" class:hidden=no_error>{error}</p>
+                            </section>
+                        }.into_any()
+                        }
+                        PageState::Ready { name, game } => view! {
+                            <div class="game-screen-wrap">
+                                <GameScreen game=game/>
+                            </div>
+                            <div class="hornet-controls">
+                                <button type="button" class="hornet-controls__fullscreen" on:click=on_fullscreen>
+                                    "Full screen"
+                                </button>
+                                <label class="hornet-controls__size">
+                                    "Screen size "
+                                    <select on:change=on_screen_size>
+                                        {SCREEN_SIZES.iter().map(|&(width, height)| view! {
+                                            <option
+                                                value=format!("{width}x{height}")
+                                                selected=(width, height) == screen_size
+                                            >
+                                                {format!("{width} \u{d7} {height}")}
+                                            </option>
+                                        }).collect_view()}
+                                    </select>
+                                </label>
+                                <span class="hornet-controls__hint">
+                                    "A new size restarts the game. In full screen, the \u{2318} key and its shortcuts go to the game. Hold Esc to leave full screen."
+                                </span>
+                            </div>
+                            <p class="hornet-controls__note" class:hidden=move || fullscreen_note.get().is_empty()>
+                                {move || fullscreen_note.get()}
+                            </p>
+                            <p class="hornet-file">
+                                "Game file: " {name} " \u{b7} "
+                                <button type="button" class="hornet-file__forget" on:click=on_forget>
+                                    "Use a different game file"
+                                </button>
+                            </p>
+                        }.into_any(),
+                    }}
+                </div>
+            </main>
+        </div>
+    }
+}
