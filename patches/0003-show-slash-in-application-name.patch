+/// Return the Finder name of the application at a VFS path.
+///
+/// The VFS separates folders with `/` and stores a `/` inside an HFS name as
+/// U+F02F. Put the `/` back, so "F/A-18 Hornet" does not show U+F02F on the
+/// host. Inside Macintosh: Files (1992), pp. 2-27 to 2-30.
+pub fn application_display_name(vfs_path: &str) -> String {
+    vfs_path
+        .rsplit('/')
+        .next()
+        .filter(|name| !name.is_empty())
+        .unwrap_or(vfs_path)
+        .replace('\u{F02F}', "/")
+}
